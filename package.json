{
  "name": "kukana-uptime",
  "version": "1.2.2",
  "main": "dist/index.js",
  "scripts": {
    "prestart": "npm run build:server",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc",
    "build:web": "vite build --config web/vite.config.mjs",
    "dev:web": "vite --config web/vite.config.mjs",
    "start": "node --env-file=.env dist/server.js",
    "build:docker": "docker build --build-arg  APP_VERSION=$npm_package_version -t kukana-uptime:$(node -p \"require('./package.json').version\") -t kukana-uptime:latest .",
    "build:docker:amd64": "docker build --platform linux/amd64 --build-arg APP_VERSION=$npm_package_version -t kukana-uptime:$(node -p \"require('./package.json').version\")-amd64 -t kukana-uptime:latest-amd64 .",
    "publish": "./scripts/publish.sh",
    "publish:amd64": "./scripts/publish.sh amd64",
    "export:docker:amd64": "docker save kukana-uptime:$(node -p \"require('./package.json').version\")-amd64 -o kukana-uptime-$(node -p \"require('./package.json').version\")-amd64.tar",
    "start:docker": "docker run --env-file .env -p 3333:3000 -e PORT=3000 -v $(pwd)/data:/app/data kukana-uptime:$npm_package_version"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "express": "^5.2.1",
    "nodemailer": "^9.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
